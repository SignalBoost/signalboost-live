VAULT_MASTER_KEY=
SLACK_VAULT_WEBHOOK_URL=

# Email / SMTP
RESEND_API_KEY=
# Where replies should go when outbound emails use a no-inbox sender alias such as saasmarketing@signalboostapp.com.
EMAIL_REPLY_TO=
REPLY_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
