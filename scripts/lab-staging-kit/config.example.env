# Non-secret settings. Copy to config.env, fill in, then: set -a; source config.env; set +a
STAGING_APP_URL=https://staging.example.com
STAGING_SUPABASE_URL="https://<staging-ref>.supabase.co"
STAGING_SUPABASE_ANON_KEY=            # publishable/anon key (public by design)
REPO_DIR=/path/to/signalboost-live
CUSTOMER_A_EMAIL=lab-staging-a+$(date +%s)@yourdomain.test
CUSTOMER_B_EMAIL=lab-staging-b+$(date +%s)@yourdomain.test
# SB_COOKIE_NAME=                     # only if staging uses a custom auth cookie name

# Verified price (filled by the verifier from the provider's published pricing page — no defaults)
RATE_PROVIDER_KIND=                   # openai | anthropic | gemini | openai_compatible
RATE_MODEL=
RATE_INPUT_USD_PER_MTOK=
RATE_OUTPUT_USD_PER_MTOK=
RATE_SOURCE_URL=https://
RATE_VERIFIED_BY=
RATE_VERIFIED_AT=                     # e.g. 2026-10-12T10:00:00Z
# RATE_OVERHEAD_TOKENS=64
# RATE_SAFETY_MARGIN=1.10

# From LAB after step 5
EXPERIMENT_A=
BASE_MODEL=                           # small model, e.g. a ~0.5B instruct model the customer may fine-tune
BASE_MODEL_REVISION=

# Paid run — ONLY after written approval
APPROVED_TEST_BUDGET_USD=
TEACHER_BUDGET_USD=                   # must be less than the total
MAX_HOURLY_USD=
APPROVED_BY=
APPROVAL_REFERENCE=                   # ticket / email / message link
# TRAINING_TIMEOUT_MIN=120

# Mandatory exact staging allowlist, checked before every API/DB operation.
STAGING_PROJECT_REF_ALLOWED=
STAGING_APP_ORIGIN_ALLOWED=
STAGING_DB_HOST_ALLOWED=
STAGING_DB_NAME_ALLOWED=postgres
# Set STAGING_DB_URL and secret keys/passwords only in the operator environment.
