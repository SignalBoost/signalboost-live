# ─────────────────────────────────────────────────────────────────────────────
# SignalBoost SaaS / Hub Console — environment variables
#
# Copy this file to .env.local for local work, or paste values into your host
# (Vercel → Project → Settings → Environment Variables). NEVER commit real
# secrets. Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
NODE_ENV=
OWNER_EMAILS=
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
OPERATOR_OWNER_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEBSITE_STARTER=
STRIPE_PRICE_WEBSITE_PRO=
STRIPE_PRICE_WEBSITE_BUSINESS=
STRIPE_PRICE_PODCAST_INDIE=
STRIPE_PRICE_PODCAST_PRO=
STRIPE_PRICE_PODCAST_NETWORK=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=

# COS independent/local reasoning. For a remote private inference service, use
# HTTPS, a server-side API key, and explicitly allow only its exact hostname.
COS_LOCAL_FIRST_ENABLED=true
COS_LOCAL_CONFIDENCE_THRESHOLD=0.72
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
LOCAL_AI_ALLOWED_HOSTS=
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_ALLOW_CLOUD_FALLBACK=false

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
ANTHROPIC_API_KEY=
