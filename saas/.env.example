# ─────────────────────────────────────────────────────────────────────────────
# SignalBoost SaaS / Hub Console — environment variables
#
# Copy this file to .env.local for local work, or paste values into your host
# (Vercel → Project → Settings → Environment Variables). NEVER commit real
# secrets. Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
NODE_ENV=
OWNER_EMAILS=
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
OPERATOR_OWNER_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEBSITE_STARTER=
STRIPE_PRICE_WEBSITE_PRO=
STRIPE_PRICE_WEBSITE_BUSINESS=
STRIPE_PRICE_PODCAST_INDIE=
STRIPE_PRICE_PODCAST_PRO=
STRIPE_PRICE_PODCAST_NETWORK=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=

# Optional buyer-defined model profiles. Server-only JSON; leave blank to use built-in validated profiles.
# Declaring a transport/capability does not enable it unless a matching validated adapter/runtime exists.
ITMOUNTS_MODEL_REGISTRY_JSON=
# COS independent/local reasoning. For a remote private inference service, use
# HTTPS, a server-side API key, and explicitly allow only its exact hostname.
COS_LOCAL_FIRST_ENABLED=true
COS_LOCAL_CONFIDENCE_THRESHOLD=0.72
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
LOCAL_AI_ALLOWED_HOSTS=
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_ALLOW_CLOUD_FALLBACK=false

# DeepInfra is a bounded managed fallback/training/assessment runtime, not an unmetered default.
# These are worst-case Harness reservations made before a paid request starts. Defaults in code are
# intentionally conservative; set lower values here to tighten Production spend without code changes.
DEEPINFRA_BUILDER_MAX_CALL_USD=0.08
DEEPINFRA_BUILDER_MAX_JOB_USD=0.24
DEEPINFRA_UNIVERSITY_PRACTICE_MAX_CALL_USD=0.005
DEEPINFRA_UNIVERSITY_PRACTICE_MAX_RUN_USD=0.01
DEEPINFRA_UNIVERSITY_ASSESSMENT_MAX_CALL_USD=0.10
DEEPINFRA_UNIVERSITY_ASSESSMENT_MAX_RUN_USD=0.10

# Optional Working COS direct-distillation runtime-binding override. Leave all three blank to use
# the versioned exact-digest allowlist. If ANY override is set, ALL three must be set and must match
# the exact Production Ollama digest plus an immutable trainable-base revision.
# Known qwen3:30b mapping: Qwen/Qwen3-30B-A3B-Thinking-2507 @
# 144afc2f379b542fdd4e85a1fcd5e1f79112d95d. Never copy a short Ollama digest prefix here.
COS_WORKING_DISTILLATION_RUNTIME_DIGEST=
COS_WORKING_DISTILLATION_BASE_MODEL_ID=
COS_WORKING_DISTILLATION_BASE_MODEL_REVISION=

# Working COS direct-training dispatch is separately fail-closed in addition to the existing
# COS_UNIVERSITY_TRAINING_EXECUTOR_DISPATCH_ENABLED gate. No GPU flavor is assumed for the 30.5B
# Production lineage: configure one deliberately after verifying live provider capacity/pricing.
COS_WORKING_DISTILLATION_DISPATCH_ENABLED=false
COS_WORKING_DISTILLATION_ROTATION_SEED=
COS_WORKING_DISTILLATION_HF_TRAINING_FLAVOR=
COS_WORKING_DISTILLATION_MAX_PREPARATION_COST_USD=0.25
COS_WORKING_DISTILLATION_MAX_HOURLY_COST_USD=1
COS_WORKING_DISTILLATION_MAX_TRAINING_COST_USD=2.5

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
