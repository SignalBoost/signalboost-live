# ─────────────────────────────────────────────────────────────────────────────
# SignalBoost SaaS / Hub Console — environment variables
#
# Copy this file to .env.local for local work, or paste values into your host
# (Vercel → Project → Settings → Environment Variables). NEVER commit real
# secrets. Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only.
#
# Sections:
#   1. Core platform (REQUIRED)
#   2. Access control (REQUIRED for the Hub Console)
#   3. Billing — Stripe
#   4. AI / media providers
#   5. Hub Console provider credentials (per provider; only set the ones you use)
#   6. Secrets vault
#   7. Email / SMTP
#   8. Cron & misc
# ─────────────────────────────────────────────────────────────────────────────


# ══ 1. CORE PLATFORM (REQUIRED) ══════════════════════════════════════════════
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe anon/publishable key (sb_publishable_... or the legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_... or the legacy service_role key).
# CANONICAL NAME. NEVER expose to the browser.
# (The deprecated alias SUPABASE_SERVICE_KEY is still read as a fallback in a few
#  routes, but new config should use SUPABASE_SERVICE_ROLE_KEY only.)
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this deployment, e.g. https://saas.signalboostapp.com
NEXT_PUBLIC_APP_URL=

# Set automatically by most hosts; leave blank locally (Next sets it to "development").
NODE_ENV=


# ══ 2. ACCESS CONTROL (REQUIRED for the Hub Console) ═════════════════════════
# Comma-separated emails granted OWNER access to the Hub Console.
# ⚠️ CRITICAL: the console authorizes owners via this list (or a team_members
# owner row). If neither is set, no one has owner access to hub actions.
OWNER_EMAILS=
# Comma-separated emails granted ADMIN access.
ADMIN_EMAILS=
# (Legacy/optional) browser-exposed admin list used by some client UI.
NEXT_PUBLIC_ADMIN_EMAILS=
# (Legacy/optional) emails allowed into the AI Website Operator owner-only feature.
OPERATOR_OWNER_EMAILS=


# ══ 3. BILLING — STRIPE ══════════════════════════════════════════════════════
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...), from Stripe → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=
# Price IDs per plan.
STRIPE_PRICE_WEBSITE_STARTER=
STRIPE_PRICE_WEBSITE_PRO=
STRIPE_PRICE_WEBSITE_BUSINESS=
STRIPE_PRICE_PODCAST_INDIE=
STRIPE_PRICE_PODCAST_PRO=
STRIPE_PRICE_PODCAST_NETWORK=
# Optional: PayPal (alternative checkout).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=


# ══ 4. AI / MEDIA PROVIDERS ══════════════════════════════════════════════════
OPENAI_API_KEY=
# Optional override; defaults to a built-in transcription model name if unset.
OPENAI_TRANSCRIPTION_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
FAL_KEY=
HEYGEN_API_KEY=


# ══ 5. HUB CONSOLE PROVIDER CREDENTIALS ══════════════════════════════════════
# Only set credentials for the providers you actually enable. Providers without
# credentials simply report "not connected" in the console.

# ── GitHub ──
# Read token (rate-limit relief for repo reads).
GITHUB_TOKEN=
# Write token (required for Chief-of-Staff commits to ai/* branches).
GITHUB_WRITE_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# ── Vercel ──
VERCEL_TOKEN=
# CANONICAL project id (prj_...). VERCEL_PROJECT_ID is read as a fallback
# (Vercel injects it automatically for the current project).
VERCEL_HUB_PROJECT=
VERCEL_PROJECT_ID=
# CANONICAL team id (team_...). VERCEL_TEAM is read as a fallback. Optional for
# personal projects.
VERCEL_TEAM_ID=
VERCEL_TEAM=

# ── AWS ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── GCP ──
GCP_PROJECT_ID=
# Path to a service-account JSON key file (or its contents, per your runtime).
GOOGLE_APPLICATION_CREDENTIALS=

# ── Auth0 ──
AUTH0_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ── Twilio (SMS / verification) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ── SendGrid (email) ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Cloudflare (DNS / CDN) ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── DigitalOcean ──
DIGITALOCEAN_TOKEN=

# ── Datadog (monitoring) ──
DATADOG_API_KEY=
DATADOG_APP_KEY=
# Region API base, e.g. https://api.datadoghq.com (or .eu). Optional.
DATADOG_API_URL=

# ── Sentry (error tracking) ──
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# ── PagerDuty (incidents) ──
PAGERDUTY_API_KEY=
PAGERDUTY_FROM_EMAIL=


# ══ 6. SECRETS VAULT ═════════════════════════════════════════════════════════
# Master key used to encrypt/decrypt stored vault secrets. Generate a strong
# random value and keep it stable — rotating it invalidates stored secrets.
VAULT_MASTER_KEY=
# Optional: Slack webhook for vault audit/alert notifications.
SLACK_VAULT_WEBHOOK_URL=


# ══ 7. EMAIL / SMTP ══════════════════════════════════════════════════════════
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=


# ══ 8. CRON & MISC ═══════════════════════════════════════════════════════════
# Shared secret protecting scheduled cron endpoints (set the same value in your
# scheduler's Authorization header).
CRON_SECRET=
SALES_CRON_SECRET=
# Test key for the admin live-fetch diagnostic route (optional; route is owner-gated).
LIVEFETCH_TEST_KEY=

# Search / media enrichment (optional).
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=
YOUTUBE_API_KEY=

# Video storage bucket name (Supabase Storage).
VIDEO_STORAGE_BUCKET=

# ── Optional: separate Supabase instances ──
# Marketing site project (affiliate_partners, etc.).
MARKETING_SUPABASE_URL=
MARKETING_SUPABASE_SERVICE_ROLE_KEY=
# "Digits" outreach feature, if used.
DIGITS_SUPABASE_URL=
DIGITS_SUPABASE_SERVICE_ROLE_KEY=
