export function createAwsDefinition(sourceId:string):IncidentSourceDefinition{return{sourceId,vendor:'AWS CloudWatch / EventBridge',status:'staged',map(body,delivery){const root=object(body),detail=object(root.detail),state=object(detail.state);if(isNonIncidentState(state.value,detail.status))return null;return mapping({provider:'aws',delivery,message:first(state.reason,detail.message,detail.alarmName,root['detail-type']),severity:first(detail.severity,state.value),environment:first(detail.environment,detail.target),detectedAt:first(root.time,detail.stateUpdatedTimestamp),errorCode:first(root.id,detail.alarmName),affectedResource:first(detail.alarmArn,Array.isArray(root.resources)?root.resources[0]:root.resources),dedupeKey:first(detail.alarmArn,detail.alarmName),metadata:{adapterId:'aws-cloudwatch-eventbridge',adapterMaturity:'staged'}})}}}
