# Copy this file to .env and replace the placeholder with a GitHub PAT.
# Never commit your real token.
GITHUB_TOKEN=github_pat_your_token_here


# Optional physical model context-window override. The platform otherwise uses a conservative
# provider-aware default (RunPod 8192; other OpenAI-compatible runtimes 32768).
LOCAL_AI_CONTEXT_WINDOW_TOKENS=
# Optional per-model override. Model names are uppercased and non-alphanumerics become underscores:
# LOCAL_AI_CONTEXT_WINDOW_QWEN_QWEN3_30B_A3B_TOKENS=32768
