    "u_8a2cc0673b1c4283": "Demo",
    "u_6d9c35974a43994d": "Nie zwrócono jeszcze żadnych danych telemetrycznych dotyczących zarządzania na żywo.",
    "u_d40fefe6d23ea7ab": "Harmonogram zarządzania",
