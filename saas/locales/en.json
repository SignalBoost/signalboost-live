    "u_caa79af4db67695c": "duration",
    "u_dcb3eeed0f2b911b": "captions",
    "u_dffa16af9340e30f": "exports record from canvas in real time.",
    "u_1f6fa6f69d185e60": " min",
    "u_dfca6272ec004413": "Request stopped. Nothing was sent and no external action was taken.",
    "u_dd8433ee354c3e99": "This task ran past the request limit, so COS could not finish it in one turn. Nothing was sent and no external action was taken. Large jobs (research several companies, then draft to each) need to be split — ask for one company at a time, or run it from the Outreach console.",
    "u_cae7d57bc067a514": "Stop",
    "u_3e43ac1f41f78189": "DEFERRED",
    "u_a18420fbf2cd5aff": "Multi-AI Project Consultation Workspace",
    "u_e5541868cbeb9c12": "One shared project room where OpenAI, Anthropic, Gemini and other selected AI providers can review the same project context, answer side by side, critique selected responses and help prepare one saved decision.",
    "u_4ba544e3e9f5102d": "Why this idea exists",
    "u_e5fbbfecc0691fe7": "During project development, the owner often consults several AI systems and manually carries context and recommendations between separate services. This workspace would organize that real internal workflow in one place.",
    "u_c6915b58ed251d92": "Possible first version",
    "u_4e6ee4c0cd3cc706": "Shared project context and files",
    "u_990089ee759098d2": "Send one question to selected providers",
    "u_6691238233f294fb": "Side-by-side responses",
    "u_44812d789cd925cf": "Ask one provider to critique another response",
    "u_a652291fa265ee80": "Create and save a combined recommendation",
    "u_d0a6f7e8f25a9f85": "Display provider, model, usage, cost and audit history",
    "u_3f7639b491e6946b": "Current decision",
    "u_9bf481bfff002a15": "Do not treat this as an active build or a proven commercial product. Revisit it later as an internal SignalBoost productivity tool, then decide whether broader usage justifies productization.",
    "u_76f29e11f9ae1412": "What are you selling? (leave empty for the SignalBoost platform preview)",
    "u_bf00f2d6ac053df7": "e.g. Self-Healing Supervisor — buyer-hosted incident supervision with human-approved remediation and signed SIEM audit evidence",
    "u_eb39a9b59ea7c14b": "Active campaign",
    "u_54b5d3195dc6949f": "None — SignalBoost platform preview",
    "u_08c9dd87e8f29cbf": "Custom (type it below)",
    "u_9d6b41c549e48d71": "The draft uses this campaign brief, the same one the background worker uses.",
    "u_ca169ad9a39d8b2c": "Add any platform",
    "u_e13bbfa1cbfd78f0": "Publish anywhere, not only to the platforms shipped above. Declare where to authorize and what a post request looks like — no code change and no release.",
    "u_1bda0ea94f93d03c": "Declare a platform",
    "u_4d855ad31368b940": "Platform id (lower-case, no spaces)",
    "u_41a37f5b02ea6532": "bluesky",
    "u_4ed485c714011860": "Bluesky",
    "u_6a1a03c4daab4ccf": "Authorize URL",
    "u_419c4bfda5ea7c40": "https://…/oauth/authorize",
    "u_804b52f6a75c7ab7": "Token URL (optional)",
    "u_0e87d26a0be2b4d5": "https://…/oauth/token",
    "u_44832b6ad20b5f69": "Scopes (space separated)",
    "u_2eb67117eab3a411": "write read",
    "u_4207937c19df071a": "Publish URL",
    "u_730cd708e1c60f41": "https://…/posts",
    "u_fdfdfab3d30bd134": "Request body — use",
    "u_ada0db1bcc3bb7d1": "{text}",
    "u_123953875dfc180b": "{videoUrl}",
    "u_7f6d1e5dc420403e": "{imageUrl}",
    "u_8cbe16eae44f4e5f": "{accountRef}",
    "u_c22e579dba452e17": "where the post content goes",
    "u_04b161225a1508f6": "Post id in response (dot path)",
    "u_cbd3a38cc39d8f59": "data.id",
    "u_6a7c5d51b88b4baa": "…or id in a response header",
    "u_a53a51e5bda57fcd": "x-post-id",
    "u_86e730a874e657da": "…or the post URL (dot path)",
    "u_b5da913936112526": "data.url",
    "u_5b7d9943d7fd77a9": "Permalink template (optional)",
    "u_6cecc5f8bb0f9a66": "https://site/p/{id}",
    "u_8c70f65de43a511b": "One of the three response fields is required. Without it a post could never be confirmed, and this connector never reports a post as published unless the platform confirms it.",
