create table if not exists users (
  id uuid primary key references auth.users on delete cascade,
  tier text default 'starter',
  auto_top_up boolean default false,
  created_at timestamp default now()
);

create table if not exists history (
  id bigint generated always as identity primary key,
  user_id uuid references users(id) on delete cascade,
  mode text not null,
  prompt text,
  output text,
  path text,
  created_at timestamp default now()
);

create table if not exists credits (
  user_id uuid primary key references users(id) on delete cascade,
  used integer default 0,
  credit_limit integer default 50,
  updated_at timestamp default now()
);

create index if not exists idx_history_user on history(user_id);
create index if not exists idx_history_mode on history(mode);

alter table users enable row level security;
alter table history enable row level security;
alter table credits enable row level security;

create policy "Users can view own profile"
on users for select
using (auth.uid() = id);

create policy "Users can update own profile"
on users for update
using (auth.uid() = id);

create policy "Users can view own history"
on history for select
using (auth.uid() = user_id);

create policy "Users can insert own history"
on history for insert
with check (auth.uid() = user_id);

create policy "Users can view own credits"
on credits for select
using (auth.uid() = user_id);

create policy "Users can update own credits"
on credits for update
using (auth.uid() = user_id);

create or replace function increment_credits(
  target_user_id uuid,
  amount int
)
returns void as $$
begin
  update credits
  set used = used + amount,
      updated_at = now()
  where credits.user_id = target_user_id;
end;
$$ language plpgsql;
