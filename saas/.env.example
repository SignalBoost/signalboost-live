HEYGEN_API_KEY=
GITHUB_TOKEN=
GITHUB_WRITE_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=
VERCEL_TOKEN=
VERCEL_HUB_PROJECT=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
AUTH0_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
