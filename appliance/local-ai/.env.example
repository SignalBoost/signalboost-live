# Runtime provider selection for the SignalBoost backend.
AI_MODEL_PROVIDER=local
LOCAL_AI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_AI_MODEL=signalboost-local-brain
LOCAL_AI_API_KEY=replace-with-a-random-appliance-secret
LOCAL_AI_TIMEOUT_MS=120000

# Privacy defaults. Keep false for air-gapped/private deployments.
LOCAL_AI_ALLOW_CLOUD_FALLBACK=false
LOCAL_AI_CLOUD_FALLBACK_PROVIDER=claude

# Model storage is populated during factory provisioning, not at customer runtime.
LOCAL_AI_MODEL_ROOT=/opt/signalboost/models
LOCAL_AI_MODEL_PATH=/models/primary
LOCAL_AI_GGUF_PATH=/models/primary/model.gguf
LOCAL_AI_MODEL_NAME=signalboost-local-brain

# vLLM profile: choose a quantized model that actually fits the shipped GPU topology.
LOCAL_AI_TENSOR_PARALLEL_SIZE=2
LOCAL_AI_MAX_MODEL_LEN=32768
LOCAL_AI_GPU_MEMORY_UTILIZATION=0.90
NVIDIA_VISIBLE_DEVICES=all
VLLM_IMAGE=vllm/vllm-openai:latest

# llama.cpp profile: appropriate for GGUF and partial/full GPU offload.
LOCAL_AI_GPU_LAYERS=999
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LOCAL_AI_HOST_PORT=8000
