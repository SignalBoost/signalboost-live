# ─────────────────────────────────────────────────────────────
# SignalBoost SaaS — required environment variables
# Copy real values into Vercel (Project → Settings → Environment Variables).
# Never commit real secrets. NEXT_PUBLIC_* are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key. Use the new Publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Use the new Secret key (sb_secret_...). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
# Public base URL of this site, e.g. https://saas.signalboostapp.com
NEXT_PUBLIC_APP_URL=
# Comma-separated admin emails
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
# Comma-separated emails allowed into the AI Website Operator (owner-only feature)
OPERATOR_OWNER_EMAILS=

# ── Stripe (billing) ──
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (whsec_...), from Stripe → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=
# Price IDs for each plan
STRIPE_PRICE_WEBSITE_STARTER=
STRIPE_PRICE_WEBSITE_PRO=
STRIPE_PRICE_WEBSITE_BUSINESS=
STRIPE_PRICE_PODCAST_INDIE=
STRIPE_PRICE_PODCAST_PRO=
STRIPE_PRICE_PODCAST_NETWORK=

# ── AI / media providers ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
HEYGEN_API_KEY=
ASSEMBLYAI_API_KEY=

# ── Other integrations ──
RESEND_API_KEY=
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=
SALES_CRON_SECRET=

# ── Optional: separate Supabase instance for the "digits" outreach feature ──
DIGITS_SUPABASE_URL=
DIGITS_SUPABASE_SERVICE_ROLE_KEY=
